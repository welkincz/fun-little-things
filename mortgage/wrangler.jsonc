{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fun-mortgage-site",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-17",
  "workers_dev": false,
  // Zone route on charliebuild.com. It runs in front of the charliebuild
  // custom-domain Worker, so only these paths leave the rest of the site.
  "routes": [
    {
      "pattern": "charliebuild.com/tools/mortgage*",
      "zone_name": "charliebuild.com"
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
